<svg width="1200" height="630" viewBox="0 0 1200 630" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Background gradient -->
  <defs>
    <linearGradient id="bgGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#FCFCFB;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#F5F5F5;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="personGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#4A5568;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#2D3748;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="stressGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#F56565;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#E53E3E;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="calmGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#48BB78;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#38A169;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="1200" height="630" fill="url(#bgGradient)"/>
  
  <!-- Stress clouds (left side) -->
  <g opacity="0.7">
    <ellipse cx="200" cy="150" rx="60" ry="40" fill="url(#stressGradient)"/>
    <ellipse cx="250" cy="140" rx="50" ry="35" fill="url(#stressGradient)"/>
    <ellipse cx="180" cy="180" rx="45" ry="30" fill="url(#stressGradient)"/>
    
    <ellipse cx="150" cy="300" rx="55" ry="38" fill="url(#stressGradient)"/>
    <ellipse cx="200" cy="290" rx="48" ry="32" fill="url(#stressGradient)"/>
    <ellipse cx="130" cy="330" rx="42" ry="28" fill="url(#stressGradient)"/>
  </g>
  
  <!-- Person figure (center) -->
  <g transform="translate(600, 200)">
    <!-- Head -->
    <circle cx="0" cy="-80" r="40" fill="url(#personGradient)"/>
    
    <!-- Body -->
    <rect x="-25" y="-40" width="50" height="80" rx="25" fill="url(#personGradient)"/>
    
    <!-- Arms -->
    <rect x="-60" y="-30" width="20" height="60" rx="10" fill="url(#personGradient)"/>
    <rect x="40" y="-30" width="20" height="60" rx="10" fill="url(#personGradient)"/>
    
    <!-- Legs -->
    <rect x="-20" y="40" width="15" height="60" rx="7" fill="url(#personGradient)"/>
    <rect x="5" y="40" width="15" height="60" rx="7" fill="url(#personGradient)"/>
    
    <!-- Stress lines around head -->
    <g stroke="#F56565" stroke-width="2" fill="none" opacity="0.6">
      <path d="M-60,-100 Q-40,-120 -20,-100"/>
      <path d="M20,-100 Q40,-120 60,-100"/>
      <path d="M-50,-90 Q-30,-110 -10,-90"/>
      <path d="M10,-90 Q30,-110 50,-90"/>
    </g>
  </g>
  
  <!-- Calm elements (right side) -->
  <g opacity="0.8">
    <!-- Meditation circle -->
    <circle cx="950" cy="200" r="80" fill="none" stroke="url(#calmGradient)" stroke-width="3" opacity="0.6"/>
    <circle cx="950" cy="200" r="60" fill="none" stroke="url(#calmGradient)" stroke-width="2" opacity="0.4"/>
    <circle cx="950" cy="200" r="40" fill="none" stroke="url(#calmGradient)" stroke-width="1" opacity="0.3"/>
    
    <!-- Calm waves -->
    <path d="M850 350 Q900 320 950 350 Q1000 380 1050 350" stroke="url(#calmGradient)" stroke-width="3" fill="none" opacity="0.7"/>
    <path d="M860 380 Q910 350 960 380 Q1010 410 1060 380" stroke="url(#calmGradient)" stroke-width="2" fill="none" opacity="0.5"/>
    <path d="M870 410 Q920 380 970 410 Q1020 440 1070 410" stroke="url(#calmGradient)" stroke-width="1" fill="none" opacity="0.3"/>
  </g>
  
  <!-- Title text -->
  <text x="600" y="500" text-anchor="middle" font-family="Arial, sans-serif" font-size="48" font-weight="bold" fill="#2D3748">
    Finding My Way Back to Unwinding
  </text>
  
  <!-- Subtitle -->
  <text x="600" y="540" text-anchor="middle" font-family="Arial, sans-serif" font-size="24" fill="#4A5568">
    A Personal Reflection on Burnout and Self-Discovery
  </text>
  
  <!-- Author -->
  <text x="600" y="580" text-anchor="middle" font-family="Arial, sans-serif" font-size="20" fill="#718096">
    By Peter Onisha
  </text>
</svg>
